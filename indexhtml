<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>查询USDT交易与快速统计收支 - 查地址</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#f0f3f8;color:#111;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;padding-bottom:40px}
a{color:inherit;text-decoration:none}
.top{background:#fff;border-bottom:1px solid #eef1f5}
.top-in{max-width:1100px;margin:0 auto;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.logo{display:flex;align-items:center;gap:8px;font-size:18px;font-weight:800;flex-shrink:0;cursor:pointer;user-select:none}
.top-right{display:flex;align-items:center;gap:8px}
.lang-wrap{display:flex;align-items:center;gap:4px;background:#f1f5f9;border:1px solid #e2e6ec;border-radius:999px;padding:4px 8px 4px 10px;flex-shrink:0}
.lang-wrap span{font-size:14px}
.lang-sel{border:0;background:transparent;font-size:13px;font-weight:600;outline:none;cursor:pointer;max-width:110px}
.batch-top{background:#2f7bff;color:#fff;border-radius:999px;padding:8px 16px;font-size:13px;font-weight:700;white-space:nowrap}
.backup-top{background:#fff;color:#666;border:1px dashed #dbe1ea;border-radius:999px;padding:8px 16px;font-size:13px;font-weight:600;white-space:nowrap;cursor:default}
.wrap{max-width:1100px;margin:0 auto;padding:0 16px}
h1{font-size:28px;font-weight:800;text-align:center;margin:36px 0 8px;line-height:1.3}
.sub{font-size:13px;color:#888;text-align:center;margin-bottom:20px}
.search{display:flex;gap:10px;background:#fff;border-radius:12px;padding:8px 8px 8px 18px;box-shadow:0 2px 10px rgba(0,0,0,.04);max-width:760px;margin:0 auto}
.search input{flex:1;border:0;outline:none;font-size:15px;min-width:0}
.search button{background:#2f7bff;color:#fff;border:0;border-radius:9px;padding:12px 28px;font-size:15px;font-weight:700;cursor:pointer}
.search button:disabled{opacity:.6}
.prices{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:22px 0 8px}
.price{background:#fff;border-radius:12px;padding:14px 16px;display:flex;align-items:center;gap:10px;box-shadow:0 1px 6px rgba(0,0,0,.03)}
.price .ico{width:36px;height:36px;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;flex-shrink:0}
.price .ico.usdt{background:#26a17b}.price .ico.btc{background:#f7931a}.price .ico.trx{background:#ff2b2b}.price .ico.eth{background:#627eea}
.price small{display:block;font-size:12px;color:#888}
.price b{font-size:16px}
.price-tip{font-size:12px;color:#aaa;text-align:center;line-height:1.6;margin:6px 0 18px}
.promos{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.promo{background:#fff;border-radius:12px;padding:22px 10px;text-align:center;box-shadow:0 1px 6px rgba(0,0,0,.03);border:1px dashed #dbe1ea;cursor:default}
.promo .big{font-size:26px;opacity:.6}
.promo b{display:block;font-size:14px;color:#666;margin:10px 0 4px}
.promo span{font-size:12px;color:#aaa}
.foot{font-size:12px;color:#aaa;text-align:center;margin-top:18px}
.card{background:#fff;border-radius:14px;padding:16px;margin:16px 0;box-shadow:0 1px 6px rgba(0,0,0,.03)}
.wallet-head{display:flex;justify-content:space-between;gap:10px;align-items:center}
.wallet-head b{font-size:13px;word-break:break-all}
.wallet-head button{background:#fff;border:1px solid #e2e6ec;border-radius:999px;padding:6px 12px;font-size:12px;cursor:pointer}
.wallet-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;margin-top:12px;font-size:13px}
.wallet-grid span{color:#666}.wallet-grid b{float:right}.wallet-grid .red{color:#e11d48}
.filter{display:flex;gap:6px;background:#f8fafc;border:1px solid #eef1f5;border-radius:10px;padding:7px 8px;overflow-x:auto;scrollbar-width:none;flex-wrap:nowrap}
.filter::-webkit-scrollbar{display:none}
.filter .tab{border:0;background:#fff;border:1px solid #e2e6ec;border-radius:999px;padding:6px 12px;font-size:13px;cursor:pointer;white-space:nowrap}
.filter .tab.on{background:#2f7bff;color:#fff;border-color:#2f7bff}
.filter select,.filter input{border:1px solid #e2e6ec;border-radius:8px;padding:6px 7px;font-size:13px;background:#fff;outline:none;min-width:0}
.filter select{width:130px}.filter input{width:86px}.filter .date{width:118px}.filter .sep{color:#999}
.filter .mini{border:1px solid #e2e6ec;background:#fff;border-radius:8px;padding:6px 9px;font-size:13px;cursor:pointer;white-space:nowrap}
.filter .go{background:#111;color:#fff;border:0;border-radius:8px;padding:6px 12px;font-size:13px;cursor:pointer;white-space:nowrap}
.summary{font-size:13px;margin:10px 2px 0}
table{width:100%;border-collapse:collapse;margin-top:10px;font-size:13px;min-width:720px}
th{color:#666;font-weight:500;text-align:left;padding:9px 8px;border-bottom:1px solid #eee;white-space:nowrap}
td{padding:10px 8px;border-bottom:1px solid #f1f2f4}
.table-wrap{overflow-x:auto}
.addr{font-family:monospace;word-break:break-all;max-width:180px}
.hash{color:#2f7bff;font-family:monospace;cursor:pointer;white-space:nowrap}
.pill{display:inline-block;border-radius:999px;padding:4px 10px;font-weight:700;font-size:13px;white-space:nowrap}
.pill.in{background:#dcfce7;color:#15803d}.pill.out{background:#fee2e2;color:#b91c1c}.pill.trx{background:#eef2ff;color:#3730a3}
.empty{padding:28px 0;text-align:center;color:#888;font-size:13px}
.pager{display:flex;gap:8px;justify-content:center;margin:14px 0 4px;flex-wrap:wrap}
.pager button{border:1px solid #e2e6ec;background:#fff;border-radius:999px;padding:6px 14px;font-size:13px;cursor:pointer}
.pager button.on{background:#2f7bff;color:#fff;border-color:#2f7bff}
.actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.actions button{border:1px solid #e2e6ec;background:#fff;border-radius:999px;padding:7px 14px;font-size:13px;cursor:pointer}
@media(max-width:640px){
  h1{font-size:21px;margin:24px 0 6px}
  .prices{grid-template-columns:repeat(2,1fr)}
  .promos{grid-template-columns:repeat(2,1fr)}
  .wallet-grid{grid-template-columns:1fr}
  .wallet-grid b{float:none;margin-left:6px}
  .search button{padding:12px 18px}
  .batch-top,.backup-top{padding:7px 12px;font-size:12px}
  .lang-sel{max-width:92px}
}
</style>
</head>
<body>
<div class="top"><div class="top-in">
  <div class="logo" onclick="goHome()" title="返回首页">
    <div style="width:28px;height:28px;border-radius:50%;background:#FF0013;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;line-height:1;flex-shrink:0">T</div>
    <span data-i18n="logo">查地址</span>
  </div>
  <div class="top-right">
    <div class="lang-wrap"><span>🌐</span><select id="langSelect" class="lang-sel" onchange="setLang(this.value)">
      <option value="zh">简体中文</option><option value="hant">繁體中文</option><option value="en">English</option><option value="th">ไทย</option><option value="vi">Tiếng Việt</option><option value="id">Bahasa Indonesia</option>
    </select></div>
    <a id="batchBtn" href="/balances.html" class="batch-top" data-i18n="batchBtn">批量查询余额和多签状态</a>
    <span id="backupBtn" class="backup-top" style="display:none" data-i18n="backup">备用网站</span>
  </div>
</div></div>

<div id="home" class="wrap">
  <h1 data-i18n="h1">查询USDT交易与快速统计收支</h1>
  <p class="sub" data-i18n="sub">支持 TRX / ETH 地址 · 后端统一查询</p>
  <div class="search">
    <input id="addrInput" data-i18n-ph="searchPh" placeholder="请输入需查询的波场TRX或以太坊ETH地址" autocomplete="off">
    <button id="searchBtn" onclick="doSearch()" data-i18n="searchBtn">搜索</button>
  </div>
  <div class="prices">
    <div class="price"><span class="ico usdt">T</span><div><small>USDT</small><b id="pUsdt">6.66 ¥</b></div></div>
    <div class="price"><span class="ico btc">₿</span><div><small>BTC</small><b id="pBtc">425,033 ¥</b></div></div>
    <div class="price"><span class="ico trx">T</span><div><small>TRX</small><b id="pTrx">2.07 ¥</b></div></div>
    <div class="price"><span class="ico eth">◆</span><div><small>ETH</small><b id="pEth">12,034 ¥</b></div></div>
  </div>
  <p class="price-tip" data-i18n="priceTip">实时获取欧易前10名商家平均价格<br>（仅供查询不支持交易）</p>
  <div class="promos">
    <div class="promo"><div class="big">📌</div><b data-i18n="promo1">推广位 1</b><span data-i18n="coming">待上新</span></div>
    <div class="promo"><div class="big">📌</div><b data-i18n="promo2">推广位 2</b><span data-i18n="coming">待上新</span></div>
    <div class="promo"><div class="big">📌</div><b data-i18n="promo3">推广位 3</b><span data-i18n="coming">待上新</span></div>
    <div class="promo"><div class="big">📌</div><b data-i18n="promo4">推广位 4</b><span data-i18n="coming">待上新</span></div>
  </div>
  <p class="foot" data-i18n="foot">数据来源：后端 TronGrid + Blockscout · 仅供查询 · 风险仅基于链上信号</p>
</div>

<div id="resultPage" class="wrap" style="display:none">
  <div class="card">
    <div class="wallet-head"><b id="wAddr">—</b><button onclick="copyAddr()" data-i18n="copy">复制地址</button></div>
    <div class="wallet-grid">
      <div><span data-i18n="trxAmt">TRX数量：</span><b id="wTrx">—</b></div>
      <div><span data-i18n="usdtAmt">USDT数量：</span><b id="wUsdt">—</b></div>
      <div><span data-i18n="energy">能量：</span><b id="wEnergy">—</b></div>
      <div><span data-i18n="active">激活时间：</span><b id="wActive">—</b></div>
      <div><span data-i18n="cny">CNY价值：</span><b id="wCny">—</b></div>
      <div><span data-i18n="multi">是否多签：</span><b id="wMulti">—</b></div>
    </div>
  </div>
  <div class="filter">
    <button class="tab on" data-coin="USDT" onclick="setCoin('USDT',this)">USDT</button>
    <button class="tab" data-coin="TRX" onclick="setCoin('TRX',this)">TRX</button>
    <select id="fType"><option value="all" data-i18n="typeAll">收支类型 · 全部</option><option value="in" data-i18n="typeIn">收入</option><option value="out" data-i18n="typeOut">支出</option></select>
    <input id="fMin" type="number" step="any" placeholder="0.001" value="0.001"><span class="sep">-</span>
    <input id="fMax" type="number" step="any" data-i18n-ph="maxAmt" placeholder="最大数量">
    <input class="date" id="fStart" type="date"><span class="sep">-</span><input class="date" id="fEnd" type="date">
    <button class="mini" onclick="clearFilter()" data-i18n="clear">清空</button><button class="go" onclick="applyFilter()" data-i18n="filter">筛选</button>
  </div>
  <div class="summary" id="summary">—</div>
  <div class="card" style="padding:8px 10px">
    <div class="table-wrap"><table><thead><tr><th data-i18n="thTime">交易时间</th><th data-i18n="thCounter">交易对象</th><th data-i18n="thCoin">币种</th><th data-i18n="thAmt">交易数量</th><th data-i18n="thBlockHash">区块哈希值</th><th data-i18n="thTxHash">交易ID哈希</th><th data-i18n="thBlock">区块高度</th></tr></thead><tbody id="tbody"></tbody></table></div>
    <div id="empty" class="empty" style="display:none" data-i18n="empty">暂无该币种交易记录</div>
    <div class="pager" id="pager"></div>
    <div class="actions"><button onclick="showAll()" data-i18n="showAll">显示全部</button><button onclick="exportExcel()" data-i18n="export">导出 Excel</button></div>
  </div>
</div>
