let curLang=localStorage.getItem('lang')||(()=>{const l=(navigator.language||'en').toLowerCase();if(l==='zh-tw'||l==='zh-hk'||l==='zh-mo'||l==='zh-hant')return 'hant';if(l.startsWith('zh'))return 'zh';if(l.startsWith('th'))return 'th';if(l.startsWith('vi'))return 'vi';if(l.startsWith('id')||l.startsWith('ms'))return 'id';return 'en';})();
function t(k){return (I18N[curLang]||I18N.en)[k]||I18N.en[k]||k;}
function setLang(l){curLang=l;localStorage.setItem('lang',l);document.getElementById('langSelect').value=l;document.querySelectorAll('[data-i18n]').forEach(e=>{e.innerHTML=t(e.dataset.i18n);});document.querySelectorAll('[data-i18n-ph]').forEach(e=>{e.placeholder=t(e.dataset.i18nPh);});if(curList.length) render();if(document.getElementById('resultPage').style.display==='block') document.getElementById('searchBtn').textContent=t('searchBtn');}
let curAddr='',allList=[],curList=[],curCoin='USDT',page=1,pageSize=20,showAllFlag=false;
function setTop(isHome){document.getElementById('batchBtn').style.display=isHome?'':'none';document.getElementById('backupBtn').style.display=isHome?'none':'';}
function goHome(){curAddr='';allList=[];curList=[];page=1;showAllFlag=false;document.getElementById('addrInput').value='';document.getElementById('home').style.display='block';document.getElementById('resultPage').style.display='none';setTop(true);window.scrollTo(0,0);}
function isPay(){const str=document.getElementById('addrInput').value.trim();if(!str){alert(t('errEmpty'));return false;}const f=str.charAt(0);if(f!=='T'&&f!=='t'&&f!=='0'){alert(t('errEmpty'));return false;}if((f==='T'||f==='t')&&str.length!==34){alert(t('errLen34'));return false;}if(f==='0'&&str.length!==42){alert(t('errLen42'));return false;}return true;}
async function doSearch(){if(!isPay())return;const v=document.getElementById('addrInput').value.trim();const btn=document.getElementById('searchBtn');btn.disabled=true;btn.textContent=t('searching');try{const r=await fetch('/api/address?address='+encodeURIComponent(v));const j=await r.json();if(j.error)throw new Error(j.error);curAddr=v;allList=j.transfers||[];document.getElementById('wAddr').textContent=v;document.getElementById('wTrx').textContent=j.trx??'—';document.getElementById('wUsdt').textContent=j.usdt??'—';document.getElementById('wEnergy').textContent=j.energy??'—';document.getElementById('wActive').textContent=j.activatedAt||'—';document.getElementById('wCny').textContent=j.cny??'—';const m=document.getElementById('wMulti');m.textContent=j.isMulti?t('yes'):t('no');m.className=j.isMulti?'red':'';document.getElementById('home').style.display='none';document.getElementById('resultPage').style.display='block';setTop(false);setCoin('USDT',document.querySelector('[data-coin="USDT"]'));}catch(e){alert(e.message||t('errFail'));}finally{btn.disabled=false;btn.textContent=t('searchBtn');}}
function setCoin(coin,el){curCoin=coin;page=1;showAllFlag=false;document.querySelectorAll('.filter .tab').forEach(b=>b.classList.toggle('on',b.dataset.coin===coin));applyFilter(true);}
function clearFilter(){document.getElementById('fType').value='all';document.getElementById('fMin').value='0.001';document.getElementById('fMax').value='';document.getElementById('fStart').value='';document.getElementById('fEnd').value='';applyFilter();}
function applyFilter(keepPage){if(!keepPage)page=1;const type=document.getElementById('fType').value;const min=parseFloat(document.getElementById('fMin').value)||0;const max=parseFloat(document.getElementById('fMax').value);const s=document.getElementById('fStart').value,e=document.getElementById('fEnd').value;curList=allList.filter(t=>{if(t.coin!==curCoin)return false;const amt=Math.abs(t.amount||0);if(type==='in'&&t.amount<0)return false;if(type==='out'&&t.amount>0)return false;if(amt<min)return false;if(!isNaN(max)&&amt>max)return false;const d=(t.time||'').slice(0,10);if(s&&d<s)return false;if(e&&d>e)return false;return true;});render();}
function render(){const total=curList.length;let inc=0,out=0;curList.forEach(t=>{if(t.amount>=0)inc+=t.amount;else out+=Math.abs(t.amount);});document.getElementById('summary').innerHTML=`${t('total')} ${total} ${t('income')} <span style="color:#15803d;font-weight:700">${inc.toLocaleString(undefined,{maximumFractionDigits:6})}</span> | ${t('expense')} <span style="color:#dc2626;font-weight:700">${out.toLocaleString(undefined,{maximumFractionDigits:6})}</span>。`;const list=showAllFlag?curList:curList.slice((page-1)*pageSize,page*pageSize);const tb=document.getElementById('tbody');tb.innerHTML='';document.getElementById('empty').style.display=total?'none':'block';list.forEach(t=>{const tr=document.createElement('tr');const isIn=t.amount>=0;const pill=curCoin==='USDT'?`<span class="pill ${isIn?'in':'out'}">${isIn?'+':'-'}${Math.abs(t.amount).toLocaleString(undefined,{maximumFractionDigits:6})}</span>`:`<span class="pill trx">${isIn?'+':'-'}${Math.abs(t.amount).toLocaleString(undefined,{maximumFractionDigits:6})}</span>`;tr.innerHTML=`<td>${t.time||''}</td><td><span class="addr">${t.counter||''}</span></td><td>${t.coin||''}</td><td>${pill}</td><td><span class="hash" onclick="toggleHash(this,'${t.blockHash||''}')">${shortHash(t.blockHash)}</span></td><td><span class="hash" onclick="toggleHash(this,'${t.txHash||''}')">${shortHash(t.txHash)}</span></td><td>${t.block||''}</td>`;tb.appendChild(tr);});const pg=document.getElementById('pager');pg.innerHTML='';if(!showAllFlag&&total>pageSize){const pages=Math.ceil(total/pageSize);const mk=(label,p)=>{const b=document.createElement('button');b.textContent=label;if(p===page)b.className='on';b.onclick=()=>{page=p;render();window.scrollTo(0,0);};pg.appendChild(b);};if(page>1)mk(t('prev'),page-1);for(let i=1;i<=pages;i++){if(i===1||i===pages||Math.abs(i-page)<=2)mk(i,i);}if(page<pages)mk(t('next'),page+1);}}
function shortHash(h){if(!h)return '—';return '*****'+String(h).slice(-6);}
function toggleHash(el,full){if(!full)return;el.textContent=el.textContent===full?shortHash(full):full;}
function showAll(){showAllFlag=true;render();}
function copyAddr(){navigator.clipboard.writeText(curAddr).then(()=>alert(t('copied')));}
function exportExcel(){let csv='\uFEFF交易时间,交易对象,币种,交易数量,区块哈希值,交易ID哈希,区块高度\n';curList.forEach(t=>{csv+=`"${t.time}","${t.counter}","${t.coin}","${t.amount}","${t.blockHash||''}","${t.txHash||''}","${t.block||''}"\n`;});const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download=curAddr+'_'+curCoin+'.csv';a.click();}
document.getElementById('addrInput').addEventListener('keydown',e=>{if(e.key==='Enter')doSearch();});
setLang(curLang);
(async()=>{try{const p=await fetch('https://api.coingecko.com/api/v3/simple/price?ids=tether,bitcoin,tron,ethereum&vs_currencies=cny').then(r=>r.json());if(p.tether?.cny)document.getElementById('pUsdt').textContent=p.tether.cny+' ¥';if(p.bitcoin?.cny)document.getElementById('pBtc').textContent=Number(p.bitcoin.cny).toLocaleString()+' ¥';if(p.tron?.cny)document.getElementById('pTrx').textContent=p.tron.cny+' ¥';if(p.ethereum?.cny)document.getElementById('pEth').textContent=Number(p.ethereum.cny).toLocaleString()+' ¥';}catch{}})();
</script>
